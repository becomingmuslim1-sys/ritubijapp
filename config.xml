<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ritubij.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Ritubij</name>
    <description>ঋতু বীজ – খাঁটি ঐতিহ্য ও মৌসুমী সম্ভার</description>
    <author email="info@ritubij.com" href="https://ritubij.com">Ritubij Team</author>
    <content src="index.html" />
    <icon src="res/icon.png" />
    
    <!-- স্প্ল্যাশ স্ক্রিনে নিজস্ব লোগো ও ব্যাকগ্রাউন্ড সেট -->
    <platform name="android">
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#ffffff" />
        <preference name="AutoHideSplashScreen" value="true" />
        <preference name="SplashScreenDelay" value="1500" />
    </platform>

    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="whatsapp:*" />
    <preference name="scheme" value="https" />
    <preference name="hostname" value="localhost" />
</widget>
